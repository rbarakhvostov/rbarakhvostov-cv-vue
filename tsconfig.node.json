{
  "extends": "./node_modules/@tsconfig/node22/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*",
    "vite/**/*"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",

    "allowImportingTsExtensions": true,

    "types": ["node"],

    "noEmit": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
